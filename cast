const VERSION = '1.1.0';

use hexydec\jslite\jslite;

Chanter::cast('build', function() {
  Crafter::item('exura', function() {
    Crafter::seed('DIST', __DIR__ . '/dist/exura.js');
    Crafter::seed('TYPE', 'plain');
    Crafter::seed('LANGUAGE', ['js']);

    Crafter::shard('src/root.js');
    Crafter::shard('src/dom.js');
    Crafter::shard('src/store.js');
    Crafter::shard('src/state.js');
    Crafter::shard('src/main.js');
  });

  Crafter::spark('exura', function() {
    global $CRAFTER_SPARK_DISTRIBUTE;

    $source = $CRAFTER_SPARK_DISTRIBUTE;
    $source = Weaver::bind($source, 'VERSION', VERSION);
    $source = str_replace("\n\n", "\n", $source);
    
    if (Chanter::spell('min') == 'true') {
      $min = new jslite();
      $min->load($source);
      $min->minify();
      $minified = $min->compile();
      Forger::item('dist/exura.min.js', $minified);
    }

    $CRAFTER_SPARK_DISTRIBUTE = $source;
  });

});

Chanter::cast('watch', function() {
  Chanter::cast('build')();
  Specter::observer('src', function() {
    Chanter::cast('build')();
  });
});

/**
 * V E R S I O N
 * The version lives in `const VERSION` (this runite edits itself);
 * build weaves it into every {{ VERSION }} of src/.
 *   php cast version                  show
 *   php cast version --up[=minor|major|release]
 *   php cast version --pre[=dev]
 *   php cast version --set=1.0.0-dev
 */
Chanter::cast('version --up --pre --set', function() {
  $next = VERSION;
  if (($set = Chanter::spell('set')) && $set !== '1') {
    $next = $set;
  }
  if ($up = Chanter::spell('up')) {
    preg_match('/^(\d+)\.(\d+)\.(\d+)/', $next, $v);
    $next = match ($up === '1' ? 'patch' : $up) {
      'major'   => ($v[1] + 1) . '.0.0',
      'minor'   => $v[1] . '.' . ($v[2] + 1) . '.0',
      'patch'   => $v[1] . '.' . $v[2] . '.' . ($v[3] + 1),
      'release' => $v[0],
      default   => false,
    };
  }
  if ($next && ($pre = Chanter::spell('pre'))) {
    $next = preg_replace('/-.*$/', '', $next) . '-' . ($pre === '1' ? 'dev' : $pre);
  }

  if ($next === VERSION) {
    Whisper::echo("{{color-info}}EXURA JS{{color-end}} " . VERSION . "{{nl}}");
    return;
  }
  if (!$next || !preg_match('/^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$/', $next)) {
    Whisper::echo("{{color-danger}}{{icon-warning}} Invalid version. Use --up=patch|minor|major|release, --pre[=dev] or --set=x.y.z{{nl}}");
    return;
  }

  $runite = file_get_contents(__FILE__);
  $runite = preg_replace("/(const VERSION = ')[^']*(')/", '${1}' . $next . '${2}', $runite, 1);
  file_put_contents(__FILE__, $runite);
  Whisper::echo("{{color-success}}{{icon-success}} EXURA JS " . VERSION . " -> $next{{nl}}");
  Whisper::echo("{{color-secondary}}Rebuild: php cast build --min=true{{nl}}");
}, 'Show or bump const VERSION (woven into src/ on build). --up=patch|minor|major|release --pre[=dev] --set=x.y.z');

